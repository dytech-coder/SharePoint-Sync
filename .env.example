# Vorlage fuer die .env - kopieren nach .env und ausfuellen:  cp .env.example .env
# Die .env enthaelt Zugangsdaten und gehoert nicht in die Versionsverwaltung.

# --- Microsoft Entra ID / SharePoint ---------------------------------------
# Verzeichnis-ID (Tenant-ID) und Anwendungs-ID (Client-ID) der App-Registrierung
SP_TENANT_ID=00000000-0000-0000-0000-000000000000
SP_CLIENT_ID=00000000-0000-0000-0000-000000000000
# SharePoint-Adresse des Tenants
SP_TENANT_URL=https://contoso.sharepoint.com

# --- Web-Oberflaeche ---------------------------------------------------------
# Zufallswert zum Signieren der Sitzungs-Cookies, erzeugen mit:  openssl rand -hex 32
SESSION_SECRET=
# Objekt-ID der Entra-Gruppe, deren Mitglieder die Web-Oberflaeche benutzen duerfen.
# Ist weder diese Gruppe noch SYNC_ADMINS gesetzt, darf JEDER Benutzer des Tenants hinein.
SYNC_ADMIN_GROUP_ID=00000000-0000-0000-0000-000000000000
# Optional: kommagetrennte Anmeldenamen, die unabhaengig von der Gruppe Zugriff erhalten (Notzugang)
SYNC_ADMINS=
# Optional: Anzeigename in Kopfzeile und Browser-Tab (Standard: SharePoint Sync)
APP_TITLE=
# Optional: E-Mail-Domain der Benutzer - Anmeldung ohne "Konto auswaehlen" (z.B. contoso.com)
LOGIN_DOMAIN_HINT=

# --- Betrieb mit Docker Compose / Traefik ---------------------------------------
# Hostname, unter dem die Web-Oberflaeche erreichbar ist (DNS muss auf den Traefik-Host zeigen)
SYNC_HOSTNAME=sync.contoso.com
# Pause zwischen zwei Sync-Laeufen in Sekunden (Standard 14400 = 4 Stunden)
SYNC_INTERVAL_SECONDS=14400
# Zeitzone fuer Protokoll und Lauf-Historie
TZ=Europe/Berlin
# Traefik: Docker-Netz, Entrypoint und Zertifikats-Resolver (Standardwerte in Klammern)
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
